{
  "manifest_version": 3,
  "name": "GETTEL Filter Autofill",
  "version": "1.1.0",
  "description": "Auto-fills search filter presets on the GETTEL Network property search page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.gettel.ca/*",
    "*://*.gettelnetwork.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GETTEL Filter Autofill"
  },
  "web_accessible_resources": [
    {
      "resources": ["page_executor.js"],
      "matches": ["*://*.gettel.ca/*", "*://*.gettelnetwork.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
